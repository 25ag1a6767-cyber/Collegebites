# CollegeBites Environment Configuration
ENVIRONMENT=development
APP_NAME=CollegeBites
PUBLIC_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/collegebites
TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/collegebites_test

# Redis (use memory:// for local single-process fallback if Redis server is unavailable)
REDIS_URL=memory://

# Security (override with strong 64+ char secrets in staging/production)
SECRET_KEY=dev-only-change-me-collegebites-secret-key-at-least-64-characters-long
QR_SIGNING_SECRET=dev-only-change-me-collegebites-qr-hmac-secret-at-least-64-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
OTP_TEST_ECHO=true

# Razorpay (leave empty locally to use Razorpay sandbox signature verification test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TEST_MODE=true

# Notifications / External Providers (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@collegebites.edu
SMS_PROVIDER=log
WHATSAPP_PROVIDER=log

# Thermal Printer Bridge (optional hardware integration)
NETWORK_PRINTER_ENABLED=false
DEFAULT_PRINTER_IP=192.168.1.200
DEFAULT_PRINTER_PORT=9100

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,exp://127.0.0.1:8081
