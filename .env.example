# ============================================================
# COLLEGEBITES - COMPLETE ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# 1. APPLICATION CONFIGURATION
# ------------------------------------------------------------

APP_NAME=CollegeBites
ENVIRONMENT=development

PUBLIC_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# Frontend application URL (production)
FRONTEND_URL=http://localhost:5173

# Backend application URL (production)
BACKEND_URL=http://localhost:8000


# ------------------------------------------------------------
# 2. DATABASE - POSTGRESQL / NEON
# ------------------------------------------------------------

# Main SQLAlchemy connection URL
# Use Neon pooled connection for normal application queries.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Direct/unpooled connection for migrations
DATABASE_URL_UNPOOLED=postgresql+psycopg://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require

# Test database
TEST_DATABASE_URL=postgresql+psycopg://postgres:password@127.0.0.1:5432/collegebites_test

# Optional Neon/Vercel-compatible connection variables
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=
DATABASE_URL_UNPOOLED=

# PostgreSQL individual connection fields
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
POSTGRES_PASSWORD=

# Database connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800


# ------------------------------------------------------------
# 3. REDIS CONFIGURATION
# ------------------------------------------------------------

# Local development
REDIS_URL=redis://localhost:6379/0

# Optional Redis settings
REDIS_CACHE_TTL=300
REDIS_SOCKET_TIMEOUT=5


# ------------------------------------------------------------
# 4. SECURITY AND AUTHENTICATION
# ------------------------------------------------------------

SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
QR_SIGNING_SECRET=REPLACE_WITH_ANOTHER_STRONG_RANDOM_SECRET

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Development only
OTP_TEST_ECHO=true

# Password security
PASSWORD_MIN_LENGTH=8

# Authentication security
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Rate limiting
RATE_LIMIT_ENABLED=true


# ------------------------------------------------------------
# 5. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# true = sandbox/test mode
# false = live mode, only after complete verification
RAZORPAY_TEST_MODE=true

# Payment currency
PAYMENT_CURRENCY=INR


# ------------------------------------------------------------
# 6. STRIPE (OPTIONAL EXISTING INTEGRATION)
# ------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_MODE=true


# ------------------------------------------------------------
# 7. EMAIL / SMTP CONFIGURATION
# ------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURE=true

# Optional email settings
EMAIL_ENABLED=false


# ------------------------------------------------------------
# 8. SMS / OTP PROVIDER
# ------------------------------------------------------------

SMS_PROVIDER=log

SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=

OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5


# ------------------------------------------------------------
# 9. WHATSAPP NOTIFICATIONS
# ------------------------------------------------------------

WHATSAPP_PROVIDER=log

WHATSAPP_API_KEY=
WHATSAPP_API_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=


# ------------------------------------------------------------
# 10. PUSH NOTIFICATIONS
# ------------------------------------------------------------

PUSH_NOTIFICATIONS_ENABLED=false

# Configure only if the existing notification implementation uses these
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=


# ------------------------------------------------------------
# 11. FILE / IMAGE STORAGE
# ------------------------------------------------------------

STORAGE_PROVIDER=local

STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# Public file base URL
STORAGE_PUBLIC_URL=


# ------------------------------------------------------------
# 12. THERMAL PRINTER CONFIGURATION
# ------------------------------------------------------------

NETWORK_PRINTER_ENABLED=false

DEFAULT_PRINTER_IP=
DEFAULT_PRINTER_PORT=9100

PRINTER_PAPER_WIDTH=80
PRINTER_AUTO_PRINT=false


# ------------------------------------------------------------
# 13. CORS CONFIGURATION
# ------------------------------------------------------------

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,exp://127.0.0.1:8081


# ------------------------------------------------------------
# 14. BACKGROUND TASKS / CELERY
# ------------------------------------------------------------

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

CELERY_TASK_ALWAYS_EAGER=false


# ------------------------------------------------------------
# 15. WEBSOCKET CONFIGURATION
# ------------------------------------------------------------

WEBSOCKET_ENABLED=true


# ------------------------------------------------------------
# 16. ORDER AND TOKEN CONFIGURATION
# ------------------------------------------------------------

ORDER_TOKEN_PREFIX=CB
ORDER_TOKEN_LENGTH=8

QR_TOKEN_EXPIRY_MINUTES=1440

# Do not allow duplicate token generation
ORDER_TOKEN_UNIQUE=true


# ------------------------------------------------------------
# 17. APPLICATION LOGGING
# ------------------------------------------------------------

LOG_LEVEL=INFO
LOG_FORMAT=json

# Never log passwords, OTPs, database URLs or payment secrets.


# ------------------------------------------------------------
# 18. BACKUP CONFIGURATION
# ------------------------------------------------------------

BACKUP_ENABLED=false
BACKUP_STORAGE_PATH=./backups


# ------------------------------------------------------------
# 19. MONITORING / HEALTH CHECKS
# ------------------------------------------------------------

HEALTH_CHECK_ENABLED=true


# ------------------------------------------------------------
# 20. MOBILE APPLICATION
# ------------------------------------------------------------

# Use the deployed backend URL for real devices.
# Do not use localhost on a physical Android device.
MOBILE_API_BASE_URL=http://localhost:8000

# Public client-side configuration only
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_APP_NAME=CollegeBites


# ------------------------------------------------------------
# 21. DEVELOPMENT / DEMO SETTINGS
# ------------------------------------------------------------

DEMO_MODE=true
SEED_DEMO_DATA=true

# Always disable demo accounts and demo seeding in production.


# ============================================================
# END OF COLLEGEBITES ENVIRONMENT CONFIGURATION
# ============================================================
