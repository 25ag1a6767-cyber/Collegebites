# ==============================================================================
# COLLEGEBITES - ENVIRONMENT CONFIGURATION (1:1 MATCH WITH APP SETTINGS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & PUBLIC URLS
# ------------------------------------------------------------------------------
ENVIRONMENT=development
APP_NAME=CollegeBites
API_PREFIX=/api/v1
COLLEGE_TIMEZONE=Asia/Kolkata

# Local dev defaults; in Vercel Production set both to your HTTPS domain:
#   PUBLIC_BASE_URL=https://collegebites-alpha.vercel.app
#   PUBLIC_FRONTEND_URL=https://collegebites-alpha.vercel.app
PUBLIC_BASE_URL=http://localhost:5173
PUBLIC_FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. POSTGRESQL / NEON DATABASE & CONNECTION POOLING
# ------------------------------------------------------------------------------
# In Neon + Vercel serverless, point DATABASE_URL to the PgBouncer `-pooler` host!
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/collegebites
DATABASE_URL_UNPOOLED=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/collegebites
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/collegebites_test

# Dedicated multi-worker container pool sizing (total conns = workers * (pool_size + max_overflow))
DB_POOL_SIZE=12
DB_MAX_OVERFLOW=18
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000

# Vercel / Serverless bounded pool (reuses connections across warm Fluid Compute requests)
DB_SERVERLESS_POOL_SIZE=2
DB_SERVERLESS_MAX_OVERFLOW=3
DB_SERVERLESS_NULLPOOL=false

# Production multi-worker ASGI settings (used by backend/run_prod.py)
UVICORN_WORKERS=4
ANYIO_THREADPOOL_TOKENS=100
PG_MAX_CONNECTIONS_BUDGET=160
REQUEST_TIMEOUT_SECONDS=30.0
LOG_FORMAT=text

# Vercel / Neon auto-injected fallback aliases (automatically read if DATABASE_URL unset)
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# NEON_DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. REDIS CACHE / RATE LIMIT STORAGE / CELERY WORKER
# ------------------------------------------------------------------------------
# Use memory:// in single-process dev without Redis, or redis:// / rediss:// (Upstash) in production
REDIS_URL=memory://
CACHE_ENABLED=true
CACHE_L1_MAX_ENTRIES=1024
CACHE_L1_MAX_TTL_SECONDS=3.0
# Vercel Upstash / KV auto-injected fallback aliases:
# KV_URL=
# UPSTASH_REDIS_URL=

# ------------------------------------------------------------------------------
# 4. SECURITY, TOKENS & SCHEDULED CRON AUTH
# ------------------------------------------------------------------------------
# Generate cryptographically random 64+ character secrets for production!
SECRET_KEY=replace-with-64-plus-char-random-jwt-signing-secret
QR_SIGNING_SECRET=replace-with-64-plus-char-random-qr-hmac-signing-secret

# Shared secret (16+ random chars) used by Vercel Schedules -> POST /api/v1/admin/maintenance/run
CRON_SECRET=replace-with-random-cron-secret-at-least-16-chars

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Must stay false in production (automatically suppressed when ENVIRONMENT=production)
OTP_TEST_ECHO=false

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAYS (STRICT ONLINE-ONLY: NO CASH / NO PAY-AT-PICKUP)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TEST_MODE=true

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_MODE=true

# ------------------------------------------------------------------------------
# 6. EMAIL OTP & NOTIFICATIONS (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# Backend accepts either SMTP_USER or SMTP_USERNAME
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM_EMAIL=noreply@collegebites.edu

# ------------------------------------------------------------------------------
# 7. MOBILE PHONE SMS / WHATSAPP OTP (TWILIO OR WEBHOOK)
# ------------------------------------------------------------------------------
# Set SMS_PROVIDER=twilio or webhook in production for phone OTP delivery
SMS_PROVIDER=log
WHATSAPP_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
SMS_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 8. OPTIONAL LAN ESC/POS THERMAL PRINTER (ON-PREM CAMPUS SERVER ONLY)
# ------------------------------------------------------------------------------
NETWORK_PRINTER_ENABLED=false
DEFAULT_PRINTER_IP=192.168.1.200
DEFAULT_PRINTER_PORT=9100

# ------------------------------------------------------------------------------
# 9. CORS & CAMPUS-NAT-AWARE RATE LIMITING
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081
RATE_LIMIT_DEFAULT=600/minute
RATE_LIMIT_READ_DEFAULT=1200/minute
RATE_LIMIT_AUTH_LOGIN=20/minute
RATE_LIMIT_ENABLED=true

# ------------------------------------------------------------------------------
# 10. FRONTEND & MOBILE BUILD VARIABLES
# ------------------------------------------------------------------------------
# Web (Vite): optional override when API is on a separate host (defaults to /api/v1)
# VITE_API_BASE_URL=/api/v1

# Mobile (Expo / EAS): point physical devices at deployed HTTPS API or local LAN IP
EXPO_PUBLIC_API_URL=https://collegebites-alpha.vercel.app/api/v1
EXPO_PUBLIC_APP_NAME=CollegeBites

# ------------------------------------------------------------------------------
# 11. OPTIONAL BROWSER WEB PUSH (VAPID)
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@collegebites.edu
