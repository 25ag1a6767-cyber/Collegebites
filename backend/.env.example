QR_SIGNING_SECRET=dev-only-change-me-collegebites-qr-hmac-secret-at-least-64-characters
CRON_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
OTP_TEST_ECHO=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TEST_MODE=true
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_MODE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM_EMAIL=noreply@collegebites.edu
SMS_PROVIDER=log
WHATSAPP_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
SMS_WEBHOOK_URL=
NETWORK_PRINTER_ENABLED=false
DEFAULT_PRINTER_IP=192.168.1.200
DEFAULT_PRINTER_PORT=9100
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_ENABLED=true
