        "SELECT food_variants.food_item_id AS food_variants_food_item_id, food_variants.name AS food_variants_name, food_variants.price_delta AS food_variants_price_delta, food_variants.absolute_price AS food_variants_absolute_price, food_variants.is_default AS food_variants_is_default, food_variants.is_available AS food_variants_is_available, food_variants.id AS food_variants_id, food_variants.created_at AS food_variants_created_at, food_variants.updated_at AS food_variants_updated_at FROM food_variants WHERE food_variants.food_item_id IN (?, ?, ?, ?)",
